---
// Portada: invitación a la guía gratuita (/guia-buenos-aires/). Reemplaza el tríptico "O que você quer viver?".
// Los botones de días abren la guía con el armador de itinerario ya en esa cantidad de días. Textos: src/data/guia.ts.
import { guia } from "../../data/guia";
const t = guia.teaser;
---
<section class="tw tw-section bg-night text-white" aria-labelledby="guia-h">
  <div class="tw-wrap grid items-center gap-12 lg:grid-cols-[1.15fr_.85fr] lg:gap-20">
    <div data-fx="up">
      <p class="m-0 text-sm font-bold uppercase tracking-[0.14em] text-celeste">{t.kicker}</p>
      <h2 id="guia-h" class="m-0 mt-4 font-display text-h2 font-semibold text-white">{t.title}</h2>
      <p class="m-0 mt-5 max-w-xl text-lead text-white/80">{t.lead}</p>
      <p class="m-0 mt-9 font-semibold text-white">{t.q}</p>
      <div class="mt-4 flex flex-wrap gap-2">
        {t.days.map((d) => (
          <a href={`${guia.path}?dias=${d}#roteiro`} class="inline-flex min-h-12 min-w-[4.5rem] items-center justify-center rounded-full border border-white/30 px-5 font-semibold text-white no-underline transition hover:border-white hover:bg-white hover:text-night">{d === 7 ? "7+" : d} dias</a>
        ))}
      </div>
      <a href={guia.path} class="tw-link mt-8 inline-flex items-center gap-2 font-semibold text-celeste">{t.cta}<i aria-hidden="true" class="tw-arrow"></i></a>
    </div>
    <ul data-fx="up" data-fx-delay="0.12" class="m-0 grid list-none gap-3 p-0">
      {t.points.map((x, i) => (
        <li class="flex items-center gap-4 rounded-xl bg-white/[0.06] px-5 py-4 ring-1 ring-white/10">
          <span aria-hidden="true" class="grid size-9 shrink-0 place-items-center rounded-full bg-primary font-display text-lg font-semibold text-white">{i + 1}</span>
          <span class="font-semibold text-white/90">{x}</span>
        </li>
      ))}
    </ul>
  </div>
</section>
