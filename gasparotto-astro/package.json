{
  "name": "gasparotto-viajes",
  "private": true,
  "type": "module",
  "scripts": {
    "css": "tailwindcss -i src/styles/tw.css -o public/assets/tw.css --minify",
    "css:watch": "tailwindcss -i src/styles/tw.css -o public/assets/tw.css --watch",
    "css:admin": "tailwindcss -i src/styles/admin.css -o public/admin/admin.css --minify",
    "css:admin:watch": "tailwindcss -i src/styles/admin.css -o public/admin/admin.css --watch",
    "fx": "node scripts/build-fx.mjs",
    "build": "npm run css && npm run css:admin && npm run fx && astro build",
    "dev": "npm run build && wrangler pages dev dist --d1=DB --r2=IMAGES",
    "seed": "wrangler d1 execute gasparotto-viajes-db --remote --file=seed.sql",
    "deploy": "npm run build && wrangler pages deploy dist",
    "db:create": "wrangler d1 create gasparotto-viajes-db",
    "r2:create": "wrangler r2 bucket create gasparotto-viajes-images",
    "project:create": "wrangler pages project create gasparotto-viajes --production-branch main",
    "secret": "wrangler pages secret put ADMIN_PASSWORD --project-name gasparotto-viajes",
    "d1:schema": "wrangler d1 execute gasparotto-viajes-db --remote --file=schema.sql",
    "audit": "node scripts/audit-links.mjs",
    "test:reservas": "node --no-warnings scripts/test-reservas.mjs",
    "test:pix": "node --no-warnings scripts/test-pix.mjs",
    "test:users": "node --no-warnings scripts/test-users.mjs",
    "test:equipo": "node --no-warnings scripts/test-equipo.mjs",
    "test:seguridad": "node --no-warnings scripts/test-seguridad.mjs",
    "test:rutas": "node --no-warnings scripts/test-rutas.mjs",
    "test:cache": "node --no-warnings scripts/test-cache.mjs",
    "test:consultas": "node --no-warnings scripts/test-consultas-voucher.mjs",
    "test:analitica": "node --no-warnings scripts/test-analitica.mjs",
    "test:google": "node --no-warnings scripts/test-google.mjs",
    "test:i18n": "node --no-warnings scripts/test-i18n.mjs",
    "test:blog-idiomas": "node --no-warnings scripts/test-blog-idiomas.mjs",
    "test:autoria": "node --no-warnings scripts/test-autoria.mjs",
    "test:blog-busqueda": "node --no-warnings scripts/test-blog-busqueda.mjs",
    "test:horarios": "node --no-warnings scripts/test-horarios.mjs",
    "test:reservas-horario": "node --no-warnings scripts/test-reservas-horario.mjs",
    "test:reservas-horario-api": "node --no-warnings scripts/test-reservas-horario-api.mjs",
    "test:formulario-horario": "node --no-warnings scripts/test-formulario-horario.mjs",
    "test:horarios-panel": "node --no-warnings scripts/test-horarios-panel.mjs",
    "test:horario-cerrado": "node --no-warnings scripts/test-horario-cerrado.mjs",
    "test:seo-paquetes": "node --no-warnings scripts/test-seo-paquetes.mjs",
    "test:reagendar": "node --no-warnings scripts/test-reagendar.mjs",
    "test:reservas-antiabuso": "node --no-warnings scripts/test-reservas-antiabuso.mjs",
    "test:opciones": "node --no-warnings scripts/test-opciones.mjs",
    "test:paquetes": "node --no-warnings scripts/test-paquetes-combinados.mjs",
    "test:mcp": "node --no-warnings scripts/test-mcp.mjs",
    "test:ia": "node --no-warnings scripts/test-ia.mjs",
    "test:ia-reservas": "node scripts/test-ia-reservas.mjs",
    "test": "npm run test:rutas && npm run test:reservas && npm run test:pix && npm run test:users && npm run test:equipo && npm run test:seguridad && npm run test:cache && npm run test:consultas && npm run test:analitica && npm run test:google && npm run test:i18n && npm run test:blog-idiomas && npm run test:autoria && npm run test:blog-busqueda && npm run test:horarios && npm run test:reservas-horario && npm run test:reservas-horario-api && npm run test:formulario-horario && npm run test:horarios-panel && npm run test:horario-cerrado && npm run test:seo-paquetes && npm run test:reagendar && npm run test:reservas-antiabuso && npm run test:opciones && npm run test:mcp && npm run test:ia && npm run test:ia-reservas",
    "new-agency": "node scripts/new-agency.mjs",
    "translate:blog": "node scripts/translate-blog.mjs"
  },
  "dependencies": {
    "motion": "^12.0.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.0",
    "astro": "^5.0.0",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.0",
    "wrangler": "^4"
  }
}
