---
// Página fija /guia-buenos-aires/ (functions/lib/site.js › pages): guía gratuita para brasileños.
// Todo el texto está en el HTML (lo lee Google); lo interactivo (armador de itinerario y checklist) lo agrega /assets/guia.js.
// Sin JavaScript se ve igual la guía completa; el armador muestra un itinerario de 3 días ya escrito.
// {{WA:…}} = enlace de WhatsApp con el mensaje escrito (lo reemplaza el motor). Textos: src/data/guia.ts.
export const partial = true;
import PageHero from "../../components/PageHero.astro";
import Btn from "../../components/Btn.astro";
import CtaBand from "../../components/CtaBand.astro";
import { metaComment } from "../../lib/meta";
import { guia } from "../../data/guia";

const WA = "{{WA:Olá! Vi o guia de Buenos Aires e quero ajuda com a minha viagem.}}";
const WA_PLAN = "{{WA:Olá! Montei meu roteiro no guia de Buenos Aires:}}";
const interests = [
  ["tango", "Tango"], ["comida", "Gastronomia"], ["compras", "Compras"], ["natureza", "Delta e natureza"],
  ["cultura", "Museus e cultura"], ["futebol", "Futebol"], ["vinho", "Vinhos"], ["noite", "Vida noturna"],
];
const who = [["casal", "Casal"], ["familia", "Família com crianças"], ["amigos", "Amigos"], ["sozinho", "Sozinho(a)"]];
// Datos estructurados: artículo + preguntas frecuentes (Google puede mostrarlas en el resultado).
const ld = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "Article", headline: guia.h1, description: guia.meta.description, inLanguage: "pt-BR", dateModified: guia.updatedIso, image: "{{SITE_URL}}/assets/city-tour.webp", author: { "@type": "Organization", name: "{{BRAND}}" }, publisher: { "@type": "Organization", name: "{{BRAND}}" }, mainEntityOfPage: "{{SITE_URL}}" + guia.path },
    { "@type": "FAQPage", mainEntity: guia.faq.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })) },
  ],
}).replace(/</g, "\\u003c");
---
<Fragment set:html={metaComment(guia.meta)} /><PageHero eyebrow="Guia grátis" title={guia.h1} lead={guia.lead}>
  <div class="mt-9 flex flex-wrap gap-3">
    <Btn variant="light" href="#roteiro">Montar meu roteiro</Btn>
    <Btn variant="ghost" href="#documentos">Ir para as dicas</Btn>
  </div>
  <p class="m-0 mt-6 text-sm text-white/70">Atualizado em {guia.updated}.</p>
</PageHero>
<link rel="stylesheet" href="/assets/guia.css?v=1" />
<script type="application/ld+json" is:inline set:html={ld}></script>

<!-- Armador de itinerario -->
<section id="roteiro" class="tw tw-section bg-white scroll-mt-20">
  <div class="tw-wrap">
    <h2 class="m-0 max-w-2xl font-display text-h2 font-semibold text-ink">Monte seu roteiro em Buenos Aires</h2>
    <p class="m-0 mt-5 max-w-2xl text-lead text-mute">Escolha os dias, quem viaja e o que você gosta. O roteiro aparece na hora, dia a dia, e você pode mandar para o seu celular pelo WhatsApp.</p>
    <form data-guia class="gg-form" action="#roteiro">
      <fieldset class="gg-f">
        <legend>Quantos dias?</legend>
        <div class="gg-chips">
          {[2, 3, 4, 5, 6, 7].map((d) => (<label class="gg-chip"><input type="radio" name="dias" value={d} checked={d === 3} /><span>{d} dias</span></label>))}
        </div>
      </fieldset>
      <fieldset class="gg-f">
        <legend>Quem viaja?</legend>
        <div class="gg-chips">
          {who.map(([v, l], i) => (<label class="gg-chip"><input type="radio" name="quem" value={v} checked={i === 0} /><span>{l}</span></label>))}
        </div>
      </fieldset>
      <fieldset class="gg-f">
        <legend>Do que você gosta? <small>(pode marcar vários)</small></legend>
        <div class="gg-chips">
          {interests.map(([v, l]) => (<label class="gg-chip"><input type="checkbox" name="gosto" value={v} checked={v === "tango" || v === "comida"} /><span>{l}</span></label>))}
        </div>
      </fieldset>
    </form>
    <div data-guia-out class="gg-out" aria-live="polite">
      <ol class="gg-days">
        <li class="gg-day"><h3>Dia 1 · Centro e Puerto Madero</h3><p><b>Manhã:</b> Obelisco, Av. 9 de Julho e Calle Florida.</p><p><b>Tarde:</b> Plaza de Mayo e Casa Rosada.</p><p><b>Noite:</b> jantar em Puerto Madero.</p></li>
        <li class="gg-day"><h3>Dia 2 · City tour e tango</h3><p><b>Manhã:</b> <a href="/paquetes/categoria/city-tour/">city tour</a> por San Telmo, La Boca, Recoleta e Palermo.</p><p><b>Noite:</b> <a href="/paquetes/categoria/show-de-tango/">show de tango com jantar</a>.</p></li>
        <li class="gg-day"><h3>Dia 3 · Delta do Tigre</h3><p><b>Dia todo:</b> <a href="/paquetes/categoria/paseos/">passeio ao Delta do Tigre</a> de barco pelos canais.</p></li>
      </ol>
    </div>
    <div class="gg-actions">
      <a data-guia-wa href={WA_PLAN} data-wa-base={WA_PLAN} target="_blank" rel="noopener" class="tw-btn tw-btn--wa"><span>Receber meu roteiro no WhatsApp</span></a>
      <button type="button" data-guia-print class="tw-btn tw-btn--line" hidden><span>Salvar em PDF</span></button>
    </div>
  </div>
</section>

<!-- Guía completa -->
<section class="tw tw-section bg-mist">
  <div class="tw-wrap grid gap-12 lg:grid-cols-[.7fr_1.3fr] lg:gap-20">
    <nav aria-label="Conteúdo do guia" class="gg-toc lg:sticky lg:top-28 lg:self-start">
      <p class="m-0 mb-4 font-semibold text-ink">Neste guia</p>
      <ol class="m-0 grid list-none gap-2 p-0">
        {guia.sections.map((s) => (<li><a href={`#${s.id}`}>{s.title}</a></li>))}
        <li><a href="#checklist">Checklist antes de viajar</a></li>
        <li><a href="#perguntas">Perguntas frequentes</a></li>
      </ol>
    </nav>
    <div>
      {guia.sections.map((s) => (
        <article id={s.id} class="gg-sec scroll-mt-24">
          <h2 class="m-0 font-display text-h3 font-semibold text-ink">{s.title}</h2>
          <div class="tw-prose mt-4" set:html={s.html} />
        </article>
      ))}
      <article id="checklist" class="gg-sec scroll-mt-24">
        <h2 class="m-0 font-display text-h3 font-semibold text-ink">Checklist antes de viajar</h2>
        <p class="m-0 mt-3 text-mute">Marque o que já está pronto. Fica salvo neste aparelho.</p>
        <p data-guia-prog class="gg-prog" hidden><span><i></i></span><b></b></p>
        <ul data-guia-check class="gg-check">
          {guia.checklist.map((c, i) => (<li><label><input type="checkbox" value={i} /><span>{c}</span></label></li>))}
        </ul>
      </article>
    </div>
  </div>
</section>

<section id="perguntas" class="tw tw-section bg-white scroll-mt-20">
  <div class="tw-wrap grid gap-12 lg:grid-cols-[.8fr_1.2fr] lg:gap-24">
    <h2 class="m-0 font-display text-h2 font-semibold text-ink lg:sticky lg:top-28 lg:self-start">Perguntas frequentes</h2>
    <div class="border-t border-ink/20">
      {guia.faq.map((f) => (
        <details class="group border-b border-ink/20">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-6 text-lg font-semibold text-ink [&::-webkit-details-marker]:hidden">
            {f.q}
            <span aria-hidden="true" class="tw-plus"></span>
          </summary>
          <p class="m-0 max-w-xl pb-7 pr-10 leading-relaxed text-mute">{f.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<CtaBand title="Quer ajuda para montar a viagem?" lead="Falamos português e estamos na Calle Florida 537. Montamos o seu roteiro com traslados, passeios e shows." label="Falar no WhatsApp" track="guia" secondary={{ label: "Ver passeios", href: "/paquetes/" }} />
<script is:inline src="/assets/guia.js?v=1" defer></script>
